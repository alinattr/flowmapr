  {
    "id": "TC005",
    "title": "API Lens analysis succeeds when submitting a valid OpenAPI spec (Basic+ user)",
    "description": "Verifies a Basic+ user can run API Lens analysis by pasting a valid OpenAPI spec and seeing services and connections in the UI.",
    "category": "API Lens Analysis API",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email/username field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Sign in\" button"
      },
      {
        "type": "assertion",
        "description": "Verify the URL contains \"/\""
      },
      {
        "type": "action",
        "description": "Click on \"API Lens\" in the main navigation"
      },
      {
        "type": "action",
        "description": "Type \"openapi: 3.0.0\\ninfo:\\n  title: Orders API\\n  version: 1.0.0\\npaths:\\n  /orders:\\n    get:\\n      responses:\\n        '200':\\n          description: OK\" into the API spec input area"
      },
      {
        "type": "action",
        "description": "Click the \"Analyze\" button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Services\" is visible"
      }
    ]
  },
