[
  {
    "id": "TC001",
    "title": "Generate a new flowchart diagram successfully (authenticated user)",
    "description": "Verifies an authenticated user can generate a new diagram and see the created diagram result in the UI.",
    "category": "Diagram Generation API",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email/username field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Sign in\" button"
      },
      {
        "type": "assertion",
        "description": "Verify the URL does not contain \"/login\""
      },
      {
        "type": "action",
        "description": "Click on \"New Diagram\""
      },
      {
        "type": "action",
        "description": "Type \"Customer checkout flow: start->validate payment->confirm\" into the prompt/requirements input"
      },
      {
        "type": "action",
        "description": "Click the \"Generate\" button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Flowchart\" is visible"
      }
    ]
  },
  {
